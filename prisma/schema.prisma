generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          Role      @default(USER)
  /// Opt-out switch for non-transactional notification emails (OTPs ignore it).
  emailNotifications Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  bookings         Booking[]
  files            File[]
  cartItems        CartItem[]
  notifications    Notification[]
  entitlements     Entitlement[]
  purchaseRequests PurchaseRequest[]
  payments         Payment[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Office {
  id          String     @id @default(cuid())
  nameAr      String?
  nameEn      String
  type        OfficeType
  price       Float
  capacity    String
  amenities   String[]
  description String?
  image       String?
  images      String[]
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  userId         String
  officeId       String?
  itemType       String
  itemName       String
  itemNameAr     String?
  status         BookingStatus @default(PENDING)
  total          Float
  startDate      DateTime?
  endDate        DateTime?
  durationType    String?
  referenceNumber String?
  rejectionReason String?
  spaceId         String?
  notes           String?
  originalTotal   Float?
  appliedHours    Float?
  paymentStatus   PaymentRequirement @default(NOT_REQUIRED)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  office Office? @relation(fields: [officeId], references: [id])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemName  String
  price     Float
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  size      Int
  type      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  activity    String
  inquiryType String
  createdAt   DateTime @default(now())
}

model Space {
  id              String   @id
  category        String
  type            String
  titleAr         String
  titleEn         String
  descAr          String
  descEn          String
  price           Int
  periodAr        String
  periodEn        String
  capacity        String
  featuresAr      String[]
  featuresEn      String[]
  images          String[]
  durationOptions Json
  hourlyPrices    Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  spaceFeatures SpaceFeature[]
}

model Feature {
  id          String      @id
  kind        FeatureKind
  nameAr      String
  nameEn      String
  descAr      String?
  descEn      String?
  category    String?
  unitPrice   Float?
  purchasable Boolean     @default(false)
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  spaceFeatures    SpaceFeature[]
  purchaseRequests PurchaseRequest[]
}

model SpaceFeature {
  id        String  @id @default(cuid())
  spaceId   String
  featureId String
  amount    Float?
  sortOrder Int     @default(0)

  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([spaceId, featureId])
}

model Entitlement {
  id                String            @id @default(cuid())
  userId            String
  featureId         String?
  nameAr            String
  nameEn            String
  kind              FeatureKind
  category          String?
  totalAmount       Float
  usedAmount        Float             @default(0)
  source            EntitlementSource
  bookingId         String?
  purchaseRequestId String?
  revoked           Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger EntitlementLedger[]

  @@unique([bookingId, featureId])
  @@index([userId])
}

model EntitlementLedger {
  id            String       @id @default(cuid())
  entitlementId String
  userId        String
  action        LedgerAction
  amount        Float
  note          String?
  bookingId     String?
  actorId       String?
  actorRole     Role?
  createdAt     DateTime     @default(now())

  entitlement Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entitlementId])
  @@index([bookingId])
}

/// One-time passcodes for email verification / passwordless flows.
/// Codes are stored hashed, never in plaintext.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// Demo-only payment records (no real gateway)
model Payment {
  id              String   @id @default(cuid())
  userId          String
  referenceNumber String   // booking reference the payment covers
  amount          Float
  method          String   @default("card")
  cardLast4       String?
  status          String   @default("PAID")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referenceNumber])
}

model PurchaseRequest {
  id              String         @id @default(cuid())
  userId          String
  featureId       String
  nameAr          String
  nameEn          String
  kind            FeatureKind
  amount          Float
  unitPrice       Float
  total           Float
  status          PurchaseStatus @default(PENDING)
  rejectionReason String?
  decidedAt       DateTime?
  decidedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id])

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum OfficeType {
  INDIVIDUAL
  SMALL
  MEDIUM
  LARGE
  THEATER
  MEETING
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum FeatureKind {
  INFO
  TIME
  QUANTITY
}

enum EntitlementSource {
  BOOKING
  PURCHASE
  ADMIN
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerAction {
  GRANT
  CLAIM
  AUTO_APPLY
  REFUND
  REVOKE
  ADJUST
}

enum PaymentRequirement {
  NOT_REQUIRED
  PENDING_PAYMENT
  PAID
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  EMAIL_VERIFY
}
