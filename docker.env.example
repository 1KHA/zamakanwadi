# Local Docker environment — the ONLY env file the compose stack reads.
#
#   cp docker.env.example .env.docker
#
# .env.docker is gitignored (matches .env*), so credentials pasted into it stay
# off git. Quoted values are fine; docker compose strips the quotes.

# ---- Local database (the `db` service in docker-compose.yml) ---------------
# Points at the Postgres container, NOT the live Supabase database.
DATABASE_URL=postgresql://zamakan:zamakan@db:5432/zamakan
DIRECT_URL=postgresql://zamakan:zamakan@db:5432/zamakan

# ---- Auth -------------------------------------------------------------------
# Must match the port published in docker-compose.yml.
NEXTAUTH_URL=http://localhost:3100
# Any long random string, e.g.  openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-long-random-string

# ---- Seeded admin (created by the migrate service on first start) -----------
# Password is only set when the admin is first created; later runs don't reset it.
ADMIN_EMAIL=admin@zamakan.com
ADMIN_PASSWORD=LocalDev-Admin-2026

# ---- Payments (Strabl) — see mdfiles/STRABL_CHECKOUT.md ---------------------
# demo = fake card form.  strabl = hosted checkout (demo endpoint returns 410).
PAYMENT_PROVIDER=strabl
STRABL_ENV=sandbox
# Sandbox platform UUID from Strabl. Blank → /payment shows "not configured".
STRABL_PLATFORM_UUID=
# Webhook signing secret (whsec_…) generated once in the Strabl dashboard under
# Integration → Secrets; register https://<site>/api/payments/strabl/webhook there.
# Blank → ALL webhooks are rejected (fail-closed).
STRABL_WEBHOOK_SECRET=

# ---- Email (Mandrill) — dormant unless EMAIL_ENABLED=true -------------------
# EMAIL_ENABLED=false
# MAILCHIMP_API_KEY=
# MAIL_FROM=
# MAIL_FROM_NAME=Zamakan
